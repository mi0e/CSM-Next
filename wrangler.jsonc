{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "csm-next",
  "keep_vars": true,
  "compatibility_date": "2026-07-15",
  // 纯静态部署：构建产物直接由 Cloudflare 静态资产服务，没有 Worker 代码。
  // Workers Builds 构建命令使用 `npm run build`，输出目录 dist/。
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
